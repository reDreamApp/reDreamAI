# Node (Supabase CLI / tooling)
node_modules/

# Env files — real secrets live in .env (ignored); *.env.example are committed templates
.env
**/.env
**/.env.local
**/.env.*.bak
infra/env/

# Supabase CLI local state
supabase/.branches/
supabase/.temp/

# Terraform / OpenTofu (infra/terraform/) — state is local and holds the
# runtime API key's secret; state and tfvars must never be committed.
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
infra/terraform/*.tfvars.json
!infra/terraform/*.tfvars.example
infra/terraform/*.tfplan
infra/terraform/tfplan
infra/terraform/crash.log
infra/terraform/override.tf
infra/terraform/override.tf.json

# Laptop-transfer bundle with real secrets — never commit
/transfer/
.claude/settings.local.json
