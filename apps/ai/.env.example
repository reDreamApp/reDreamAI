# Mistral API — real values live only in the gitignored .env (NEVER commit them)
MISTRAL_API_KEY=
SCALEWAY_API_KEY=

# Models — pinned per ADR 0010 (do not use floating aliases).
# Chat/routing/safety-critic model IDs are pinned in code, not env:
# core/agent.py::MODELS (ADR 0010, 2026-07-01 amendment).
MISTRAL_SAFETY_MODEL=ministral-8b-2512
VOXTRAL_TTS_MODEL=voxtral-mini-tts-2603
VOXTRAL_STT_MODEL=voxtral-mini-latest

# Voxtral saved voices — one per language (open decision; see ADR 0010)
VOXTRAL_VOICE_ID_EN=
VOXTRAL_VOICE_ID_DE=

# Supabase Storage — rehearsal audio upload target
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=rehearsal-audio

# Langfuse — self-hosted v2 per ADR 0007
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Explicit off-switch; tracing is also off whenever host/keys are unset.
# "true"/"false"; leaving it empty is tolerated and means the default (true).
LANGFUSE_ENABLED=true

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
