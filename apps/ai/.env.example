# Mistral API — real values live only in the gitignored .env (NEVER commit them)
MISTRAL_API_KEY=
SCALEWAY_API_KEY=

# Models — pinned per ADR 0010 (do not use floating aliases).
# Chat/routing/safety-critic model IDs are pinned in code, not env:
# core/agent.py::MODELS (ADR 0010, 2026-07-01 amendment).
MISTRAL_SAFETY_MODEL=ministral-8b-2512
VOXTRAL_TTS_MODEL=voxtral-mini-tts-2603
# STT (ADR 0010, 2026-07-09 amendment): Whisper on Scaleway primary (raw voice
# audio stays in the zero-retention chain), Voxtral Transcribe V2 fallback.
WHISPER_STT_MODEL=openai/whisper-large-v3:fp16
VOXTRAL_STT_MODEL=voxtral-mini-2602

# Voxtral TTS voice per language: a preset slug (GET /v1/audio/voices) or a
# saved voice id. TTS rejects requests without one. No German preset exists yet.
VOXTRAL_VOICE_ID_EN=gb_jane_neutral
VOXTRAL_VOICE_ID_DE=gb_jane_neutral

# Supabase Storage — rehearsal audio upload target
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=rehearsal-audio
# Public Supabase host for the signed audio URLs (needed when SUPABASE_URL is internal)
SUPABASE_PUBLIC_URL=
# Lifetime of the signed audio URL stored on the dream (default 1 year)
REHEARSAL_URL_TTL_SECONDS=31536000

# Langfuse — self-hosted v2 per ADR 0007
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Explicit off-switch; tracing is also off whenever host/keys are unset.
# "true"/"false"; leaving it empty is tolerated and means the default (true).
LANGFUSE_ENABLED=true

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
