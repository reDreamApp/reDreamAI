[Unit]
Description=Delete Langfuse traces past their retention period (reDreamAI)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
# Run through bash so the job does not depend on the file's executable bit,
# which an rsync deploy can reset.
ExecStart=/bin/bash /srv/redreamai/infra/langfuse/retention.sh
# The script reads /srv/redreamai/infra/env/retention.env itself, if present.
