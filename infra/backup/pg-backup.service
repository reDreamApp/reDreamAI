[Unit]
Description=Postgres backup to Scaleway Object Storage (reDreamAI)
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
# Run through bash so the job does not depend on the file's executable bit,
# which an rsync deploy can reset.
ExecStart=/bin/bash /srv/redreamai/infra/backup/pg-backup.sh
# The script sources /srv/redreamai/infra/env/backup.env itself.
