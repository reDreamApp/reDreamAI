# Caddy reverse proxy — TLS via Let's Encrypt, SSE-friendly by default.
#
# {$DOMAIN} is read from caddy.env (e.g. DOMAIN=redream.example.com).
# Routes:
#   {$DOMAIN}           → api:8001        (mobile clients hit /api/v1/...)
#   supabase.{$DOMAIN}  → kong:8000       (mobile clients: auth/GoTrue — the app's
#                                          SUPABASE_URL; `kong` is the alias of
#                                          Supabase's API gateway in the external
#                                          supabase network this stack attaches to)
#   langfuse.{$DOMAIN}  → langfuse:3000   (auth handled by Langfuse itself;
#                          answers only when Langfuse is switched on, infra/.env)
#
# Caddy does not buffer reverse-proxied responses, so SSE chat streams flow
# through without extra config (unlike nginx where `proxy_buffering off` is
# required — see ADR 0009).

{$DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 26MiB
    }
    handle_path /downloads/* {
        # Tester APK distribution (files live in /srv/downloads on the host,
        # mounted read-only into the container). Clean URLs install better on
        # Android than presigned object-storage links.
        root * /srv/downloads
        file_server
    }
    handle {
        reverse_proxy api:8001
    }
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri delete
                request>headers>Referer delete
            }
        }
    }
}

supabase.{$DOMAIN} {
    # The mobile app's SUPABASE_URL. Only two things are public: GoTrue
    # (sign-in, refresh, JWKS) and the signed URLs of rehearsal audio.
    # PostgREST, GraphQL, Realtime, Functions and Studio stay unreachable from
    # outside: the app tables carry no user-facing RLS policies, apps/api is
    # the only door to them.
    encode zstd gzip
    request_body {
        max_size 1MiB
    }
    @public path /auth/v1/* /storage/v1/object/sign/*
    handle @public {
        reverse_proxy kong:8000
    }
    handle {
        respond 404
    }
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri delete
                request>headers>Referer delete
            }
        }
    }
}

# apps/ai has no site on purpose: it takes unauthenticated requests and is
# only called by apps/api over the internal network (http://ai:8080).

langfuse.{$DOMAIN} {
    reverse_proxy langfuse:3000
}
