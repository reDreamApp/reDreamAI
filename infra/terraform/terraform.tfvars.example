# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored —
# never commit it.

project_id = "00000000-0000-0000-0000-000000000000"

# Public keys that may log in as root. `deploy` is the public half of the key
# whose private half is the GitHub secret SCALEWAY_SSH_KEY.
ssh_public_keys = {
  laptop = "ssh-ed25519 AAAA... you@laptop"
  # deploy = "ssh-ed25519 AAAA... redreamai-deploy"
}

# Optional overrides (defaults in variables.tf):
# region              = "fr-par"
# zone                = "fr-par-1"
# instance_type       = "GP1-XS"
# root_volume_size_gb = 50
# ssh_allowed_cidrs   = ["0.0.0.0/0"]
# backup_bucket_name  = "redreamai-backups"
