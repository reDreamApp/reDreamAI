# Provider API keys — Scaleway is the primary path, direct Mistral the fallback (ADR 0010)
SCALEWAY_API_KEY=
MISTRAL_API_KEY=

# Pinned model IDs — ADR 0010 as amended (never floating aliases for prod).
# Chat/routing/safety-critic IDs are pinned in code (core/agent.py::MODELS,
# 2026-07-01 amendment), NOT here. Only the classifier + audio models are env.
MISTRAL_SAFETY_MODEL=ministral-8b-2512
VOXTRAL_TTS_MODEL=voxtral-mini-tts-2603
# STT (2026-07-09 amendment): Whisper on Scaleway primary, Voxtral V2 fallback.
WHISPER_STT_MODEL=openai/whisper-large-v3:fp16
VOXTRAL_STT_MODEL=voxtral-mini-2602

# Voxtral saved voices — pre-created via the Voxtral Voices API. One per language.
# (TTS still stubbed; voice-source decision parked — see docs/ROADMAP.md.)
VOXTRAL_VOICE_ID_EN=
VOXTRAL_VOICE_ID_DE=

# Supabase Storage (rehearsal audio upload target).
# `kong` is the Supabase API gateway service inside the supabase network.
SUPABASE_URL=http://kong:8000
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=rehearsal-audio

# Langfuse self-hosted v2 (ADR 0007) — pointed at the langfuse service in this compose.
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=true

ENVIRONMENT=production
LOG_LEVEL=INFO
