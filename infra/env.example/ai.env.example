# Provider API keys — Scaleway is the primary path, direct Mistral the fallback (ADR 0010)
SCALEWAY_API_KEY=
# Project the key above is restricted to (terraform: `tofu output project_id`).
# Without it Scaleway resolves requests to the organization's default project
# and answers 403 to a project-restricted key.
SCALEWAY_PROJECT_ID=
MISTRAL_API_KEY=

# Pinned model IDs — ADR 0010 as amended (never floating aliases for prod).
# Chat/routing/safety-critic IDs are pinned in code (core/agent.py::MODELS,
# 2026-07-01 amendment), NOT here. Only the classifier + audio models are env.
# Crisis classifier (2026-10-21 amendment): Scaleway primary, Mistral fallback.
SCALEWAY_SAFETY_MODEL=mistral-small-3.2-24b-instruct-2506
MISTRAL_SAFETY_MODEL=ministral-8b-2512
VOXTRAL_TTS_MODEL=voxtral-mini-tts-3-0
# STT (2026-07-09 amendment): Whisper on Scaleway primary, Voxtral V2 fallback.
WHISPER_STT_MODEL=openai/whisper-large-v3:fp16
VOXTRAL_STT_MODEL=voxtral-mini-2602

# Voxtral TTS voice per language: a preset slug (GET /v1/audio/voices) or a
# saved voice id. TTS rejects requests without one. German: preset "Heidi"
# (needs the speech v3 model above).
VOXTRAL_VOICE_ID_EN=gb_jane_neutral
VOXTRAL_VOICE_ID_DE=voice_481

# Supabase Storage (rehearsal audio upload target).
# `kong` is the Supabase API gateway service inside the supabase network.
SUPABASE_URL=http://kong:8000
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=rehearsal-audio
# Public Supabase host for the signed audio URLs (needed when SUPABASE_URL is internal)
SUPABASE_PUBLIC_URL=https://supabase.redream.example.com
# Lifetime of the signed audio URL stored on the dream (default 5 minutes)
REHEARSAL_URL_TTL_SECONDS=300

# Langfuse self-hosted v2 (ADR 0007) — pointed at the langfuse service in this compose.
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=true

ENVIRONMENT=production
LOG_LEVEL=INFO
