# Mistral API
MISTRAL_API_KEY=

# Pinned model IDs — ADR 0010 (never floating aliases for prod).
MISTRAL_RESPONSE_MODEL=mistral-small-2603
MISTRAL_ROUTING_MODEL=ministral-8b-2512
MISTRAL_SAFETY_MODEL=ministral-8b-2512
VOXTRAL_TTS_MODEL=voxtral-mini-tts-2603
VOXTRAL_STT_MODEL=voxtral-mini-2602

# Voxtral voice per language: a preset slug or a saved voice id (TTS rejects requests without one)
VOXTRAL_VOICE_ID_EN=gb_jane_neutral
VOXTRAL_VOICE_ID_DE=gb_jane_neutral

# Supabase Storage (rehearsal audio upload target).
# `kong` is the Supabase API gateway service inside the supabase network.
SUPABASE_URL=http://kong:8000
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=rehearsal-audio
# Public Supabase host the phone can reach; signed audio URLs are rewritten to it.
SUPABASE_PUBLIC_URL=https://supabase.redreamai.com
# Lifetime of the signed audio URL stored on the dream (default 1 year).
REHEARSAL_URL_TTL_SECONDS=31536000

# Langfuse self-hosted v2 (ADR 0007) — pointed at the langfuse service in this compose.
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

ENVIRONMENT=production
LOG_LEVEL=INFO
