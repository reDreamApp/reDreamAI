# Langfuse self-hosted v2 (ADR 0007).
# Uses a dedicated `langfuse` database in the Supabase Postgres.
# infra/bootstrap.sh creates the role and the database (owned by the role).

DATABASE_URL=postgresql://langfuse:<password>@supabase-db:5432/langfuse

# Externally-visible Langfuse URL (used by NextAuth for callback URLs).
NEXTAUTH_URL=https://langfuse.redream.example.com
NEXTAUTH_SECRET=
SALT=

# Disable telemetry (sends usage stats to Langfuse Cloud).
TELEMETRY_ENABLED=false

# No public sign-up. AUTH_DISABLE_SIGNUP is the switch the server enforces;
# NEXT_PUBLIC_SIGN_UP_DISABLED alone leaves POST /api/auth/signup open
# (seen on v2.95.11). The admin account comes from LANGFUSE_INIT_* below.
AUTH_DISABLE_SIGNUP=true
NEXT_PUBLIC_SIGN_UP_DISABLED=true

# Created on first start (infra/bootstrap.sh generates the values): one
# organisation, one project with an API key pair, and the admin user.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
